{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runbook",
  "version": "0.3.1",
  "identifier": "io.github.alejandrops317.runbook",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Runbook",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Runbook contributors",
    "homepage": "https://github.com/AlejandroPS317/Runbook",
    "copyright": "Copyright (c) 2026 Alejandro and the Runbook contributors",
    "license": "MIT OR Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Run package.json scripts without opening an IDE",
    "longDescription": "Runbook finds every package.json in a project or monorepo (pnpm and npm workspaces), lists the scripts grouped by package, and runs each one in its own terminal tab. Stopping a script stops every process it started.",
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwQTQzNDRGQTZDRjYwNjcKUldSbllNK21UelNrQUhtcElkRjZRUWNGMGRuOEtnU25DUmNWd3RDMU05U01BWmtHNmt1S0Rvb1gK",
      "endpoints": [
        "https://github.com/AlejandroPS317/Runbook/releases/latest/download/latest.json"
      ]
    }
  }
}
